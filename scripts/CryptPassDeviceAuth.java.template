package __PACKAGE__;

import android.app.Activity;
import android.app.KeyguardManager;
import android.content.Context;
import android.content.Intent;
import android.os.Build;
import android.view.View;
import android.view.inputmethod.InputMethodManager;
import org.apache.cordova.CallbackContext;
import org.apache.cordova.CordovaArgs;
import org.apache.cordova.CordovaPlugin;
import org.json.JSONException;

public final class CryptPassDeviceAuth extends CordovaPlugin {
    private static final int REQUEST_CODE = 47821;
    private CallbackContext pendingCallback;

    @Override
    public boolean execute(String action, CordovaArgs args, CallbackContext callback) throws JSONException {
        KeyguardManager keyguard = (KeyguardManager) cordova.getActivity().getSystemService(Context.KEYGUARD_SERVICE);
        boolean secure = Build.VERSION.SDK_INT >= 23 ? keyguard.isDeviceSecure() : keyguard.isKeyguardSecure();
        if ("hasScreenLock".equals(action)) {
            callback.success(secure ? "true" : "false");
            return true;
        }
        if ("showKeyboard".equals(action)) {
            Activity activity = cordova.getActivity();
            activity.runOnUiThread(() -> {
                InputMethodManager keyboard = (InputMethodManager) activity.getSystemService(Context.INPUT_METHOD_SERVICE);
                View target = activity.getCurrentFocus();
                if (target == null) target = webView.getView();
                if (keyboard != null) keyboard.showSoftInput(target, InputMethodManager.SHOW_IMPLICIT);
                callback.success();
            });
            return true;
        }
        if (!"confirm".equals(action)) return false;
        if (!secure) {
            callback.success("false");
            return true;
        }
        if (pendingCallback != null) {
            callback.error("Authentication is already in progress");
            return true;
        }
        String title = args.getString(0);
        String description = args.getString(1);
        Intent intent = keyguard.createConfirmDeviceCredentialIntent(title, description);
        if (intent == null) {
            callback.success("false");
            return true;
        }
        pendingCallback = callback;
        cordova.startActivityForResult(this, intent, REQUEST_CODE);
        return true;
    }

    @Override
    public void onActivityResult(int requestCode, int resultCode, Intent data) {
        if (requestCode != REQUEST_CODE || pendingCallback == null) return;
        CallbackContext callback = pendingCallback;
        pendingCallback = null;
        callback.success(resultCode == Activity.RESULT_OK ? "true" : "false");
    }
}
